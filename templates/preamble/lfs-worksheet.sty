% lfs-worksheet.sty — ワークシート（記入式プリント）の共通設定（lecture-factory-starter）
%
% 使い方:
%   \documentclass[a4paper,11pt]{ltjsarticle}
%   \usepackage{lfs-worksheet}
%   \lfsheader{基礎数学}{第01回 ワークシート}
%
%   \answerbox[4cm]{$x = 3$}   % 学生用は空欄、解答版は中に答えを表示
%
% 解答版は worksheet_answers.tex のように \def\lfsShowAnswers{} を定義してから
% 本体を \input すると、同じソースから作れます。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lfs-worksheet}[2026/11/17 lecture-factory-starter worksheet]

\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{lfs-fonts}}
\ProcessOptions\relax

\RequirePackage{lfs-fonts}
\RequirePackage{amsmath,amssymb}
\RequirePackage{graphicx}
\RequirePackage[margin=18mm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\RequirePackage{fancyhdr}

\graphicspath{{figures/}}

\newif\iflfsanswers
\ifdefined\lfsShowAnswers \lfsanswerstrue \else \lfsanswersfalse \fi

% ヘッダー：左＝科目名、右＝タイトル。氏名欄つき
\newcommand{\lfsheader}[2]{%
  \pagestyle{fancy}\fancyhf{}%
  \lhead{#1}\rhead{#2\iflfsanswers\ \textcolor{red}{【解答】}\fi}%
  \cfoot{\thepage}%
  \noindent\textbf{\Large #2}\hfill 学籍番号\,\underline{\hspace{30mm}}\quad 氏名\,\underline{\hspace{40mm}}\par\medskip}

% 記入欄。高さは学生用・解答版で同じ（枠の大きさで答えが推測されないように揃える）
%   \answerbox[高さ]{解答}
\newcommand{\answerbox}[2][2.5cm]{%
  \par\noindent
  \begin{tcolorbox}[colback=white,colframe=black!60,boxrule=0.4pt,arc=1mm,
      height=#1,valign=top,left=2mm,right=2mm,top=1mm,bottom=1mm]
    \iflfsanswers\color{red}#2\fi
  \end{tcolorbox}}

% 小問（\problem{問題文}）
\newcounter{lfsq}
\newcommand{\problem}[1]{\par\medskip\stepcounter{lfsq}\noindent\textbf{問\thelfsq}\quad #1\par}

\endinput
